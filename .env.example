# SME-Identidade-ETL — variáveis de ambiente
# Copie para .env e ajuste os valores

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=[DJANGO_SECRET_KEY]
DJANGO_DEBUG=[DJANGO_DEBUG]
DJANGO_ALLOWED_HOSTS=[DJANGO_ALLOWED_HOSTS]
NOME_APLICACAO=[NOME_APLICACAO]
AMBIENTE_APLICACAO=[AMBIENTE_APLICACAO]
NIVEL_LOG=[NIVEL_LOG]

# ---------------------------------------------------------------------------
# Autenticação API
# ---------------------------------------------------------------------------
API_KEY=[API_KEY]
API_KEY_HEADER=[API_KEY_HEADER]

# ---------------------------------------------------------------------------
# Banco SYNC_REC_DB
# POSTGRES_USER/PASSWORD/DB_NAME são usadas pelo docker-compose-dev.yml
# para inicializar o container postgres local e montar a SYNC_REC_DB_URL
# ---------------------------------------------------------------------------
SYNC_REC_DB_URL=[SYNC_REC_DB_URL]
POSTGRES_USER=[POSTGRES_USER]
POSTGRES_PASSWORD=[POSTGRES_PASSWORD]
SYNC_REC_DB_NAME=[SYNC_REC_DB_NAME]

# ---------------------------------------------------------------------------
# Celery / KeyDB
# ---------------------------------------------------------------------------
URL_KEYDB=[URL_KEYDB]

# ---------------------------------------------------------------------------
# Keycloak
# ---------------------------------------------------------------------------
KEYCLOAK_URL_SERVIDOR=[KEYCLOAK_URL_SERVIDOR]
KEYCLOAK_REALM=[KEYCLOAK_REALM]
KEYCLOAK_CLIENT_ID=[KEYCLOAK_CLIENT_ID]
KEYCLOAK_CLIENT_SECRET=[KEYCLOAK_CLIENT_SECRET]
KEYCLOAK_USUARIO_ADMIN=[KEYCLOAK_USUARIO_ADMIN]
KEYCLOAK_SENHA_ADMIN=[KEYCLOAK_SENHA_ADMIN]
KEYCLOAK_VERIFICAR_SSL=[KEYCLOAK_VERIFICAR_SSL]
KEYCLOAK_SUFIXO_CLIENT=[KEYCLOAK_SUFIXO_CLIENT]

# ---------------------------------------------------------------------------
# token-ms
# ---------------------------------------------------------------------------
# TOKEN_MS_URL deve incluir o prefixo de serviço, ex.:
# https://qa-identidade.sme.prefeitura.sp.gov.br/identidade-token
TOKEN_MS_URL=[TOKEN_MS_URL]
TOKEN_MS_API_KEY=[TOKEN_MS_API_KEY]
TOKEN_MS_API_KEY_HEADER=[TOKEN_MS_API_KEY_HEADER]
TOKEN_MS_TIMEOUT=[TOKEN_MS_TIMEOUT]
TOKEN_MS_TAMANHO_LOTE=[TOKEN_MS_TAMANHO_LOTE]

# ---------------------------------------------------------------------------
# ETL — controle de carga
# ---------------------------------------------------------------------------
ETL_CARGA_KEYCLOAK_BULK_HABILITADO=[ETL_CARGA_KEYCLOAK_BULK_HABILITADO]
ETL_CHUNK_SIZE=[ETL_CHUNK_SIZE]
ETL_LOTE_MAXIMO=[ETL_LOTE_MAXIMO]

# ---------------------------------------------------------------------------
# SE1426 (PRODAM) — SQL Server
# ---------------------------------------------------------------------------
SE1426_DB_SERVIDOR=[SE1426_DB_SERVIDOR]
SE1426_DB_NOME=[SE1426_DB_NOME]
SE1426_DB_USUARIO=[SE1426_DB_USUARIO]
SE1426_DB_SENHA=[SE1426_DB_SENHA]
SE1426_DB_TIMEOUT=[SE1426_DB_TIMEOUT]

SE1426_API_URL=[SE1426_API_URL]
SE1426_API_TOKEN=[SE1426_API_TOKEN]
SE1426_API_TIMEOUT=[SE1426_API_TIMEOUT]

# ---------------------------------------------------------------------------
# EOL_DB — SQL Server
# ---------------------------------------------------------------------------
EOL_DB_STRING_CONEXAO=[EOL_DB_STRING_CONEXAO]

# ---------------------------------------------------------------------------
# CoreSSO — SQL Server
# ---------------------------------------------------------------------------
CORESSO_DB_SERVIDOR=[CORESSO_DB_SERVIDOR]
CORESSO_DB_NOME=[CORESSO_DB_NOME]
CORESSO_DB_USUARIO=[CORESSO_DB_USUARIO]
CORESSO_DB_SENHA=[CORESSO_DB_SENHA]
CORESSO_DB_TIMEOUT=[CORESSO_DB_TIMEOUT]

CORESSO_API_URL=[CORESSO_API_URL]
CORESSO_API_TOKEN=[CORESSO_API_TOKEN]
CORESSO_EXCLUDE_SISTEMA_IDS=[CORESSO_EXCLUDE_SISTEMA_IDS]

# ---------------------------------------------------------------------------
# Elastic APM (opcional)
# ---------------------------------------------------------------------------
ELASTIC_APM_HABILITADO=[ELASTIC_APM_HABILITADO]
ELASTIC_APM_NOME_SERVICO=[ELASTIC_APM_NOME_SERVICO]
ELASTIC_APM_TOKEN_SECRETO=[ELASTIC_APM_TOKEN_SECRETO]
ELASTIC_APM_URL_SERVIDOR=[ELASTIC_APM_URL_SERVIDOR]
ELASTIC_APM_AMBIENTE=[ELASTIC_APM_AMBIENTE]
